rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection testing endpoint for boots
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // Unified Business Store Scope (Shared across all authorized devices of Ahmed and Hamdy)
    match /stores/{storeId} {
      allow read, write: if isSignedIn() && isValidId(storeId);

      match /{subcollection}/{docId} {
        allow read, write: if isSignedIn() && isValidId(docId);
      }
    }

    // User scope collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Merchants
      match /merchants/{merchantId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(merchantId);
      }

      // Products
      match /products/{productId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(productId);
      }

      // Invoices
      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(invoiceId);
      }

      // Payments
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(paymentId);
      }

      // Expenses and Withdrawals
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(expenseId);
      }

      // Work Orders
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(orderId);
      }

      // Personal Contacts
      match /personal_contacts/{contactId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(contactId);
      }

      // Personal Transactions
      match /personal_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
