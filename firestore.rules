rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidTenantPermissions(p) {
      return p is map
        && p.keys().hasOnly([
          'showHome',
          'showMerchants',
          'showWorkOrders',
          'showPersonal',
          'showDebts',
          'showArchive',
          'showActivityLog',
          'showSettings',
          'showCloudStatus'
        ])
        && (!('showHome' in p) || p.showHome is bool)
        && (!('showMerchants' in p) || p.showMerchants is bool)
        && (!('showWorkOrders' in p) || p.showWorkOrders is bool)
        && (!('showPersonal' in p) || p.showPersonal is bool)
        && (!('showDebts' in p) || p.showDebts is bool)
        && (!('showArchive' in p) || p.showArchive is bool)
        && (!('showActivityLog' in p) || p.showActivityLog is bool)
        && (!('showSettings' in p) || p.showSettings is bool)
        && (!('showCloudStatus' in p) || p.showCloudStatus is bool);
    }

    function isValidTenant(data) {
      return data.keys().hasAll(['name', 'pin', 'createdAt'])
        && data.keys().hasOnly(['name', 'pin', 'createdAt', 'logoUrl', 'permissions'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.pin is string && data.pin.size() > 0 && data.pin.size() <= 30
        && data.createdAt is string && data.createdAt.size() <= 50
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 200000))
        && (!('permissions' in data) || isValidTenantPermissions(data.permissions));
    }

    // Connection testing endpoint for boots
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // SaaS Tenants Registry & Isolated Subscriber Workspaces
    match /tenants/{tenantId} {
      allow get, list: if true;
      allow create, update: if isValidId(tenantId) && isValidTenant(request.resource.data);
      allow delete: if isValidId(tenantId);

      match /{subcollection}/{docId} {
        allow get, list: if isValidId(tenantId);
        allow create, update, delete: if isValidId(tenantId) && isValidId(docId);
      }
    }

    // Unified Business Store Scope (Shared across all authorized devices of Ahmed and Hamdy)
    match /stores/{storeId} {
      allow read, write: if true;

      match /{subcollection}/{docId} {
        allow get, list: if true;
        allow create, update, delete: if true;
      }
    }

    // Settings Collection Scope (System Settings, Device Names, Global Config)
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // Global SaaS Master Auth Configuration
    match /global_settings/{docId} {
      allow get: if isValidId(docId);
      allow create, update: if isValidId(docId)
        && request.resource.data.keys().hasAll(['pin'])
        && request.resource.data.keys().hasOnly(['pin', 'updatedAt'])
        && request.resource.data.pin is string
        && request.resource.data.pin.size() > 0
        && request.resource.data.pin.size() <= 30;
    }

    // User scope collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Merchants
      match /merchants/{merchantId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(merchantId);
      }

      // Products
      match /products/{productId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(productId);
      }

      // Invoices
      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(invoiceId);
      }

      // Payments
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(paymentId);
      }

      // Expenses and Withdrawals
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(expenseId);
      }

      // Work Orders
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(orderId);
      }

      // Personal Contacts
      match /personal_contacts/{contactId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(contactId);
      }

      // Personal Transactions
      match /personal_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
