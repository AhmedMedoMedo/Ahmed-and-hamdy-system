{
  "entities": {
    "Merchant": {
      "title": "Merchant",
      "description": "Merchant or client profile containing contact info and notes",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product sold to merchants with pricing",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "createdAt", "updatedAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sales invoice registered under a merchant's name",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "merchantName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 20 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "merchantName", "date", "monthKey", "total", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Received payments or installments from merchants",
      "type": "object",
      "properties": {
        "merchantId": { "type": "string", "maxLength": 128 },
        "merchantName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "merchantName", "amount", "date", "monthKey", "createdAt", "updatedAt"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "Preparation work order requested by a merchant for delivery",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 50 },
        "merchantId": { "type": "string", "maxLength": 128 },
        "merchantName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 20 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["pending", "partially_delivered", "delivered", "cancelled"] },
        "totalEstimatedAmount": { "type": "number" },
        "deliveredTotalAmount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["merchantId", "merchantName", "date", "status", "createdAt", "updatedAt"]
    },
    "PersonalContact": {
      "title": "PersonalContact",
      "description": "Individual contact in independent personal account ledger",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "createdAt", "updatedAt"]
    },
    "PersonalTransaction": {
      "title": "PersonalTransaction",
      "description": "Personal account record (loan given, received, personal expense or income)",
      "type": "object",
      "properties": {
        "contactId": { "type": "string", "maxLength": 128 },
        "contactName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["loan_given", "loan_received", "expense", "income"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["type", "amount", "date", "monthKey", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expenses, salaries, maintenance and cash withdrawals",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 20 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "amount", "date", "monthKey", "createdAt", "updatedAt"]
    },
    "SecurityConfig": {
      "title": "SecurityConfig",
      "description": "Store security configuration including PIN passkey and lock settings",
      "type": "object",
      "properties": {
        "pin": { "type": "string", "maxLength": 30 },
        "isPinEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["pin", "updatedAt"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "SaaS subscriber tenant record with organization name, optional logo URL, permissions, and login PIN",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "pin": { "type": "string", "maxLength": 30 },
        "logoUrl": { "type": "string", "maxLength": 200000 },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "pin", "createdAt"]
    },
    "MasterAuthConfig": {
      "title": "MasterAuthConfig",
      "description": "Dynamic SaaS master admin login PIN configuration",
      "type": "object",
      "properties": {
        "pin": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string" }
      },
      "required": ["pin"]
    }
  },
  "firestore": {
    "/global_settings/{docId}": {
      "schema": "MasterAuthConfig",
      "description": "Global SaaS configuration such as dynamic Master Admin PIN"
    },
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "SaaS subscriber tenants managed by the system admin"
    },
    "/tenants/{tenantId}/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Isolated merchants catalog for a SaaS tenant"
    },
    "/tenants/{tenantId}/products/{productId}": {
      "schema": "Product",
      "description": "Isolated products catalog for a SaaS tenant"
    },
    "/tenants/{tenantId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Isolated sales invoices for a SaaS tenant"
    },
    "/tenants/{tenantId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Isolated merchant payments for a SaaS tenant"
    },
    "/tenants/{tenantId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Isolated expenses and withdrawals for a SaaS tenant"
    },
    "/tenants/{tenantId}/orders/{orderId}": {
      "schema": "WorkOrder",
      "description": "Isolated work orders for a SaaS tenant"
    },
    "/tenants/{tenantId}/personal_contacts/{contactId}": {
      "schema": "PersonalContact",
      "description": "Isolated personal ledger contacts for a SaaS tenant"
    },
    "/tenants/{tenantId}/personal_transactions/{transactionId}": {
      "schema": "PersonalTransaction",
      "description": "Isolated personal ledger transactions for a SaaS tenant"
    },
    "/tenants/{tenantId}/config/{configId}": {
      "schema": "SecurityConfig",
      "description": "Isolated configuration and security settings for a SaaS tenant"
    },
    "/users/{userId}/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Merchants managed by the authenticated user"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog managed by the authenticated user"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Sales invoices for merchants"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payments collected from merchants"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business expenses and withdrawals that reduce net collections"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "WorkOrder",
      "description": "Preparation work orders for merchants"
    },
    "/users/{userId}/personal_contacts/{contactId}": {
      "schema": "PersonalContact",
      "description": "Contacts for personal ledger"
    },
    "/users/{userId}/personal_transactions/{transactionId}": {
      "schema": "PersonalTransaction",
      "description": "Independent personal transactions"
    },
    "/stores/{storeId}/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Unified business store merchants catalog"
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": "Product",
      "description": "Unified business store products catalog"
    },
    "/stores/{storeId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Unified business store sales invoices"
    },
    "/stores/{storeId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Unified business store merchant payments"
    },
    "/stores/{storeId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Unified business store expenses and cash withdrawals"
    },
    "/stores/{storeId}/orders/{orderId}": {
      "schema": "WorkOrder",
      "description": "Unified business store preparation work orders"
    },
    "/stores/{storeId}/personal_contacts/{contactId}": {
      "schema": "PersonalContact",
      "description": "Unified personal ledger contacts"
    },
    "/stores/{storeId}/personal_transactions/{transactionId}": {
      "schema": "PersonalTransaction",
      "description": "Unified personal ledger transactions"
    },
    "/stores/{storeId}/config/{configId}": {
      "schema": "SecurityConfig",
      "description": "Store configuration and security settings"
    }
  }
}
